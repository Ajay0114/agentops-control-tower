
POSTGRES_USER=agentops
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=agentops

# Used when running the API directly on the host (uvicorn, pytest, alembic).
# docker-compose's own `api` service builds this itself from the POSTGRES_*
# values above, pointed at the `postgres` container instead of localhost.
DATABASE_URL=postgresql+psycopg://agentops:replace_with_a_local_password@localhost:5434/agentops

APP_NAME=AgentOps Control Tower API
APP_ENV=local

# Only read by docker-compose's `frontend` service, and only consulted
# there if LOCAL_AUTH_BYPASS=true - leave unset for a normal multi-tenant
# deployment (see docker-compose.yml's own comments and docs/architecture/
# m7-dashboard-and-auth.md section 11).
AGENTOPS_API_KEY=
